# Telegram API Credentials
# Get these from https://my.telegram.org/apps
TELEGRAM_API_ID=your_api_id_here
TELEGRAM_API_HASH=your_api_hash_here

# Session string for user authentication
# Generate this using the session generation script (see README.md)
# Optional: If not set, you'll be prompted for interactive authentication
TELEGRAM_SESSION=your_session_string_here
